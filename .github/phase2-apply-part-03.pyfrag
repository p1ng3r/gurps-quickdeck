    this.render(false);\n  }\n\n\n  async rollPrimaryAttribute':'    this.persistRosterState();\n    this.requestOverlayRender(["left", "center", "right"], { reason: "next-roster-actor" });\n  }\n\n\n  async rollPrimaryAttribute',\n'      this.invalidateDerivedActorData(actor.id);\n      this.render(false);':'      this.invalidateDerivedActorData(actor.id);\n      this.requestOverlayRender("center", { reason: "resource-update" });',\n'    this._pendingAttackGuidance = success ? { actorId: actor.id, attackIndex } : null;\n    this.render(false);':'    this._pendingAttackGuidance = success ? { actorId: actor.id, attackIndex } : null;\n    this.requestOverlayRender(["center", "right"], { reason: "guided-attack" });',\n'      this.render(false, { focus: false });\n      this.scheduleNativeWindowFocusAfterRender();\n    });\n\n    html.find("[data-action=\'toggle-center-favorite-section\']")':'      this.requestOverlayRender(["center", "right"], { reason: "favorite-spell" });\n      this.scheduleNativeWindowFocusAfterRender();\n    });\n\n    html.find("[data-action=\'toggle-center-favorite-section\']")',\n'      this.render(false, { focus: false });\n    });\n\n\n\n    html.find("[data-action=\'toggle-drawer\']")':'      this.requestOverlayRender("center", { reason: "favorite-section" });\n    });\n\n\n\n    html.find("[data-action=\'toggle-drawer\']")',\n'      this.isActionsDrawerOpen = true;\n      this.render(false);\n    });':'      this.isActionsDrawerOpen = true;\n      this.requestOverlayRender("right", { reason: "drawer-tab" });\n    });',\n'    html.find("[data-action=\'toggle-info-popover\']").on("click", (event) => { event.preventDefault(); event.stopPropagation(); this.isInfoPopoverOpen = !this.isInfoPopoverOpen; this.render(false); });':'    html.find("[data-action=\'toggle-info-popover\']").on("click", (event) => { event.preventDefault(); event.stopPropagation(); this.isInfoPopoverOpen = !this.isInfoPopoverOpen; this.requestOverlayRender("chrome", { reason: "info-popover" }); });',\n'          this.render(false);\n        }':'          this.requestOverlayRender("right", { reason: "choose-pdf" });\n        }',\n'      this.clearPdfMapDraft();\n      this.render(false);':'      this.clearPdfMapDraft();\n      this.requestOverlayRender("right", { reason: "save-pdf" });',\n'      this.clearPdfMapDraft();\n      this.render(false);\n    });':'      this.clearPdfMapDraft();\n      this.requestOverlayRender("right", { reason: "clear-pdf-draft" });\n    });',\n'      this.pdfMapDraft = { key, name: String(mapping.name ?? ""), path: String(mapping.path ?? ""), offset: Number(mapping.offset) || 0 };\n      this.render(false);':'      this.pdfMapDraft = { key, name: String(mapping.name ?? ""), path: String(mapping.path ?? ""), offset: Number(mapping.offset) || 0 };\n      this.requestOverlayRender("right", { reason: "edit-pdf" });',\n'      await this.savePdfPageRefMappings(mappings);\n      this.render(false);':'      await this.savePdfPageRefMappings(mappings);\n      this.requestOverlayRender("right", { reason: "remove-pdf" });',\n'        this.ensureActorTab(actor.id);\n        console.log("gurps-quickdeck | Actor dropped", actor.name);\n        this.render(false, { focus: false });':'        this.ensureActorTab(actor.id);\n        console.log("gurps-quickdeck | Actor dropped", actor.name);\n        this.requestOverlayRender(["left", "center", "right"], { reason: "roster-drop" });'\n}\nfor old,new in replacements.items():\n    if old in s:\n        s=s.replace(old,new,1)\n    else:\n        print('WARN missing scoped replacement',old[:80])\n\np.write_text(s,encoding='utf-8')\n\n# Build region templates from the original overlay before replacing the shell.\nroot=Path.cwd()\ntpl=(root/'templates/quickdeck-overlay.hbs').read_text(encoding='utf-8').splitlines()\nparts=root/'templates/parts'\nparts.mkdir(exist_ok=True)\n# 1-indexed inclusive helper\nget=lambda a,b:'\n'.join(tpl[a-1:b]).strip()+"\n"\n(parts/'quickdeck-chrome.hbs').write_text(get(2,38),encoding='utf-8')\n(parts/'quickdeck-left-drawer.hbs').write_text(get(56,138),encoding='utf-8')\n(parts/'quickdeck-center.hbs').write_text(get(140,388),encoding='utf-8')\n(parts/'quickdeck-right-drawer.hbs').write_text(get(390,600),encoding='utf-8')\nshell='''<div class="qd40-frame">\n  <!-- qd-region:chrome:start -->\n  {{{chromeRegionHtml}}}\n  <!-- qd-region:chrome:end -->\n\n  <div class="qd40-body qd-ui2-body">\n    <section\n      class="qd40-shell qd-ui2-shell {{#if isRosterDrawerOpen}}qd-ui2-left-open{{else}}qd-ui2-left-collapsed{{/if}} {{#if isActionsDrawerOpen}}qd-ui2-right-open{{else}}qd-ui2-right-collapsed{{/if}}"\n      data-active-drawer="{{activeDrawer}}"\n      aria-label="QuickDeck UI2 shell"\n    >\n      <button\n        class="qd-ui2-edge-tab qd-ui2-left-tab"\n        type="button"\n        data-action="toggle-roster-drawer"\n        title="{{#if isRosterDrawerOpen}}Collapse Active Characters drawer{{else}}Open Active Characters drawer{{/if}}"\n        aria-expanded="{{#if isRosterDrawerOpen}}true{{else}}false{{/if}}"\n      >\n        <span>{{#if isRosterDrawerOpen}}‹ Close{{else}}Active ›{{/if}}</span>\n      </button>\n\n      <!-- qd-region:left:start -->\n      {{{leftRegionHtml}}}\n      <!-- qd-region:left:end -->\n\n      <!-- qd-region:center:start -->\n      {{{centerRegionHtml}}}\n      <!-- qd-region:center:end -->\n\n      <!-- qd-region:right:start -->\n      {{{rightRegionHtml}}}\n      <!-- qd-region:right:end -->\n\n      <button\n        class="qd-ui2-edge-tab qd-ui2-right-tab"\n        type="button"\n        data-action="toggle-actions-drawer"\n        data-drawer="combat"\n        title="{{#if isActionsDrawerOpen}}Collapse action drawer{{else}}Open action drawer{{/if}}"\n        aria-expanded="{{#if isActionsDrawerOpen}}true{{else}}false{{/if}}"\n      >\n        <span>{{#if isActionsDrawerOpen}}Close ›{{else}}‹ Actions{{/if}}</span>\n      </button>\n    </section>\n  </div>\n</div>\n'''\n(root/'templates/quickdeck-overlay.hbs').write_text(shell,encoding='utf-8')\n